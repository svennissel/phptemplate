{% extends 'base.html.twig' %}

{% block title %}{{ currentList ? currentList.name : 'Einkaufzettel' }}{% endblock %}
{% block pageTitle %}{{ currentList ? currentList.name : 'Einkaufzettel' }}{% endblock %}

{% block topbarActions %}
    <button type="button" class="topbar-btn" onclick="openCreateListDialog()" aria-label="Neuen Einkaufzettel erstellen">
        <i class="fa-solid fa-plus"></i>
    </button>
{% endblock %}

{% block content %}
    {% if error %}
        <p class="error">{{ error }}</p>
    {% endif %}

    {% if currentList is null %}
        <div style="padding-top: 1rem;">
            <p class="muted">Noch kein Einkaufzettel vorhanden. Erstelle einen über das <i class="fa-solid fa-plus"></i> oben.</p>
        </div>
    {% else %}
        <form method="post" class="form add-item-form">
            <input type="hidden" name="action" value="add_item">
            <input type="hidden" name="list_id" value="{{ currentList.id }}">
            <div class="search-row">
                <input type="text" name="name" id="item-input" placeholder="Eintrag hinzufügen..." required autocomplete="off" list="suggestions">
                <datalist id="suggestions"></datalist>
                <button type="submit" class="btn btn-primary search-btn" aria-label="Hinzufügen">
                    <i class="fa-solid fa-plus"></i>
                </button>
            </div>
        </form>

        <div class="shopping-list-container">
            {% if items is empty %}
                <p class="muted no-items-msg">Der Einkaufzettel ist leer.</p>
            {% else %}
                <ul class="card-list shopping-items">
                    {% for item in items %}
                        <li class="card shopping-item" data-item-id="{{ item.id }}">
                            <div class="card-link shopping-item-row">
                                <div class="card-main shopping-item-main">
                                    <div class="card-title">{{ item.name }}</div>


                                </div>
                                <div class="amount-control">
                                    <button type="button" class="amount-btn" onclick="updateAmount({{ item.id }}, 1)" aria-label="Menge erhöhen">
                                        <i class="fa-solid fa-plus"></i>
                                    </button>
                                    <span class="amount-value">{{ item.amount }}</span>
                                    <button type="button" class="amount-btn" onclick="updateAmount({{ item.id }}, -1)" aria-label="Menge verringern">
                                        <i class="fa-solid fa-minus"></i>
                                    </button>
                                </div>
                                <button type="button" class="shopping-item-delete" onclick="markItemForDeletion(this.closest('.shopping-item'))" aria-label="Löschen">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                                <button type="button" class="shopping-item-undo" onclick="undoItemDeletion(this.closest('.shopping-item'))" aria-label="Rückgängig" style="display:none;">
                                    <i class="fa-solid fa-rotate-left"></i>
                                </button>
                            </div>
                            <form method="post" class="shopping-item-delete-form" style="display:none;">
                                <input type="hidden" name="action" value="delete_item">
                                <input type="hidden" name="list_id" value="{{ currentList.id }}">
                                <input type="hidden" name="item_id" value="{{ item.id }}">
                            </form>
                            <form method="post" id="update-amount-form-{{ item.id }}" style="display:none;">
                                <input type="hidden" name="action" value="update_item_amount">
                                <input type="hidden" name="list_id" value="{{ currentList.id }}">
                                <input type="hidden" name="item_id" value="{{ item.id }}">
                                <input type="hidden" name="delta" value="0">
                            </form>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    {% endif %}

    <div id="listModal" class="modal">
        <div class="modal-content">
            <h2 class="page-title">Neuen Einkaufzettel erstellen</h2>
            <form method="post" class="form">
                <input type="hidden" name="action" value="create_list">

                <label for="list-name">Name</label>
                <input type="text" name="name" id="list-name" required>

                <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                    <button type="submit" class="btn btn-primary" style="flex: 1; margin-top: 0;">Erstellen</button>
                    <button type="button" class="btn btn-primary" style="flex: 1; margin-top: 0; background: var(--text-muted);" onclick="closeListModal()">Abbrechen</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const undoTimers = {};

        function createItemElement(id, name, amount, listId) {
            const li = document.createElement('li');
            li.className = 'card shopping-item';
            li.dataset.itemId = id;
            if (String(id).startsWith('temp-')) {
                li.classList.add('is-temporary');
            }
            
            li.innerHTML = `
                <div class="card-link shopping-item-row">
                    <div class="card-main shopping-item-main">
                        <div class="card-title">${name}</div>
                    </div>
                    <div class="amount-control">
                        <button type="button" class="amount-btn" onclick="updateAmount('${id}', 1)" aria-label="Menge erhöhen">
                            <i class="fa-solid fa-plus"></i>
                        </button>
                        <span class="amount-value">${amount}</span>
                        <button type="button" class="amount-btn" onclick="updateAmount('${id}', -1)" aria-label="Menge verringern">
                            <i class="fa-solid fa-minus"></i>
                        </button>
                    </div>
                    <button type="button" class="shopping-item-delete" onclick="markItemForDeletion(this.closest('.shopping-item'))" aria-label="Löschen">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                    <button type="button" class="shopping-item-undo" onclick="undoItemDeletion(this.closest('.shopping-item'))" aria-label="Rückgängig" style="display:none;">
                        <i class="fa-solid fa-rotate-left"></i>
                    </button>
                </div>
            `;
            return li;
        }

        // Formular-Submit für Hinzufügen abfangen
        const addItemForm = document.querySelector('.add-item-form');
        const itemInput = document.getElementById('item-input');
        const suggestionsDatalist = document.getElementById('suggestions');

        if (itemInput) {
            let timeout = null;
            itemInput.addEventListener('input', function(e) {
                const q = this.value.trim();
                const listId = {{ currentList.id|default(0) }};

                // Prüfen ob der Wert aus der Datalist ausgewählt wurde
                const options = suggestionsDatalist.options;
                let found = false;
                for (let i = 0; i < options.length; i++) {
                    if (options[i].value === q) {
                        found = true;
                        break;
                    }
                }

                if (found) {
                    // Vorschläge leeren und sofort absenden
                    suggestionsDatalist.innerHTML = '';
                    addItemForm.requestSubmit();
                    return;
                }

                clearTimeout(timeout);
                
                if (q.length < 1 || listId === 0) {
                    suggestionsDatalist.innerHTML = '';
                    return;
                }

                timeout = setTimeout(async () => {
                    try {
                        const response = await fetch(`api/suggestions.php?list_id=${listId}&q=${encodeURIComponent(q)}`);
                        const suggestions = await response.json();
                        
                        suggestionsDatalist.innerHTML = '';
                        suggestions.forEach(s => {
                            const option = document.createElement('option');
                            option.value = s;
                            suggestionsDatalist.appendChild(option);
                        });
                    } catch (e) {
                        console.error('Fehler beim Laden der Vorschläge', e);
                    }
                }, 300);
            });
        }

        if (addItemForm) {
            addItemForm.addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const name = formData.get('name').trim();
                const listId = parseInt(formData.get('list_id'));
                
                if (name && listId) {
                    const tempId = 'temp-' + Date.now();
                    
                    // Vorschläge leeren
                    suggestionsDatalist.innerHTML = '';
                    
                    // Sofort in die Liste einfügen
                    let listUl = document.querySelector('.shopping-items');
                    if (!listUl) {
                        // Falls die Liste vorher leer war, UL erstellen
                        const noItemsMsg = document.querySelector('.no-items-msg');
                        if (noItemsMsg) noItemsMsg.remove();
                        
                        listUl = document.createElement('ul');
                        listUl.className = 'card-list shopping-items';
                        document.querySelector('.add-item-form').after(listUl);
                    }
                    
                    const newItemEl = createItemElement(tempId, name, 1, listId);
                    listUl.appendChild(newItemEl);
                    
                    await addToSyncQueue('add_item', { list_id: listId, name: name, temp_id: tempId });
                    
                    this.reset();
                    this.querySelector('input[name="name"]').focus();
                }
            });
        }

        // Nach dem Sync temporäre IDs durch echte IDs ersetzen (falls wir die Seite nicht neu laden)
        // Da wir aber aktuell keine ID vom Server zurückbekommen im Sync-Endpunkt ohne größere Änderungen,
        // laden wir die Seite neu, sobald der Sync für das Hinzufügen durch ist?
        // Nein, die Anforderung sagt "nicht neu geladen werden".
        // Also müssen wir entweder die ID vom Server holen oder damit leben, dass Aktionen auf dem temp-Item
        // in die Queue gehen und dort evtl. Probleme machen wenn sie auf die echte ID gemappt werden müssten.
        
        window.addEventListener('sync-completed', function(e) {
            // Wenn Ergebnisse vom Server vorliegen (z.B. neue IDs für add_item)
            if (e.detail.results && e.detail.results.length > 0) {
                e.detail.results.forEach(res => {
                    if (res.action === 'add_item' && res.temp_id && res.server_id) {
                        const itemEl = document.querySelector(`[data-item-id="${res.temp_id}"]`);
                        if (itemEl) {
                            // ID im DOM aktualisieren
                            itemEl.dataset.itemId = res.server_id;
                            itemEl.classList.remove('is-temporary');
                            
                            // Eventuelle Buttons mit alter ID aktualisieren (z.B. onclick)
                            const amountBtns = itemEl.querySelectorAll('.amount-btn');
                            amountBtns.forEach(btn => {
                                const onclick = btn.getAttribute('onclick');
                                if (onclick) {
                                    btn.setAttribute('onclick', onclick.replace(`'${res.temp_id}'`, res.server_id));
                                }
                            });
                        }
                    }
                });
            }
        });

        async function markItemForDeletion(itemEl) {
            if (!itemEl || itemEl.classList.contains('to-delete')) return;
            const itemId = itemEl.dataset.itemId;

            itemEl.classList.add('to-delete');
            itemEl.querySelector('.shopping-item-delete').style.display = 'none';
            itemEl.querySelector('.shopping-item-undo').style.display = 'inline-flex';

            undoTimers[itemId] = setTimeout(async function () {
                if (String(itemId).startsWith('temp-')) {
                    // Temporäre Items können einfach entfernt werden, falls sie noch nicht gesynct sind
                    // Eigentlich müssten wir sie aus der Queue entfernen.
                    // Der Einfachheit halber lassen wir den Reload nach dem Add-Sync das regeln.
                    itemEl.remove();
                } else {
                    await addToSyncQueue('delete_item', { item_id: parseInt(itemId) });
                    itemEl.remove(); 
                }
            }, 3000);
        }

        function undoItemDeletion(itemEl) {
            if (!itemEl) return;
            const itemId = itemEl.dataset.itemId;
            if (undoTimers[itemId]) {
                clearTimeout(undoTimers[itemId]);
                delete undoTimers[itemId];
            }
            itemEl.classList.remove('to-delete');
            itemEl.querySelector('.shopping-item-delete').style.display = 'inline-flex';
            itemEl.querySelector('.shopping-item-undo').style.display = 'none';
        }

        async function updateAmount(itemId, delta) {
            const itemEl = document.querySelector(`[data-item-id="${itemId}"]`);
            if (itemEl) {
                const amountValueEl = itemEl.querySelector('.amount-value');
                let currentAmount = parseInt(amountValueEl.textContent);
                let newAmount = Math.max(1, currentAmount + delta);
                
                if (newAmount !== currentAmount) {
                    amountValueEl.textContent = newAmount;
                    if (!String(itemId).startsWith('temp-')) {
                        await addToSyncQueue('update_item_amount', { item_id: parseInt(itemId), delta: delta });
                    }
                }
            }
        }

        function openCreateListDialog() {
            document.getElementById('list-name').value = '';
            document.getElementById('listModal').style.display = 'flex';
            history.pushState({listModalOpen: true}, '');
            setTimeout(function () { document.getElementById('list-name').focus(); }, 0);
        }

        function closeListModal(fromHistory = false) {
            document.getElementById('listModal').style.display = 'none';
            if (!fromHistory && history.state && history.state.listModalOpen) {
                history.back();
            }
        }

        window.addEventListener('click', function (event) {
            const modal = document.getElementById('listModal');
            if (event.target === modal) {
                closeListModal();
            }
        });

        window.addEventListener('popstate', function () {
            if (document.getElementById('listModal').style.display === 'flex') {
                closeListModal(true);
            }
        });
    </script>
{% endblock %}
