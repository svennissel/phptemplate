{% extends 'base.html.twig' %}

{% block title %}Benutzer{% endblock %}
{% block pageTitle %}Benutzer{% endblock %}

{% block content %}
    {% if error %}
        <p class="error">{{ error }}</p>
    {% endif %}

    {% if currentUser.is_admin %}
        <div style="margin-bottom: 1.5rem; display: flex; justify-content: flex-end;">
            <button class="btn btn-primary" style="margin-top: 0; width: auto; padding-left: 1.5rem; padding-right: 1.5rem;" onclick="openAddUserDialog()">
                <i class="fas fa-plus" style="margin-right: 0.5rem;"></i> Benutzer hinzufügen
            </button>
        </div>
    {% endif %}

    {% if users is empty %}
        <p class="muted">Es sind noch keine Benutzer angelegt.</p>
    {% else %}
        <ul class="card-list">
            {% for user in users %}
                <li class="card">
                    <div class="card-link" 
                         {% if currentUser.is_admin %}
                            style="cursor: pointer"
                            onclick="openEditDialog({{ user|json_encode|e('html_attr') }})"
                         {% else %}
                            onclick="window.location.href='profil.php?id={{ user.id }}'"
                         {% endif %}
                    >
                        <div class="card-main">
                            <div class="card-title">{{ user.name }}</div>
                        </div>
                        {% if user.is_admin %}
                            <span class="badge">Admin</span>
                        {% endif %}
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% endif %}

    {% include 'user_edit_modal.html.twig' %}
{% endblock %}
