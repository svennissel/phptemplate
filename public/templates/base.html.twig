<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="css/fontawesome.css">
    <link rel="stylesheet" href="css/style.css">
    <script src="js/form.js" defer></script>
</head>
<body>
<div class="app">
    {% block header %}
        <header class="topbar">
            <div class="topbar-title">{% block pageTitle %}{% endblock %}</div>
        </header>
    {% endblock %}

    <main class="content">
        {% block content %}{% endblock %}
    </main>

    {% block nav %}
        <nav class="bottom-nav" aria-label="Hauptnavigation">
            {% if currentUser is defined and currentUser %}
                <a href="start.php" class="nav-item {{ activePage == 'start' ? 'active' : '' }}">
                    <span class="nav-icon"><i class="fa-solid fa-house"></i></span>
                    <span class="nav-label">Start</span>
                </a>
                {% if currentUser.is_admin %}
                    <a href="users.php" class="nav-item {{ activePage == 'users' ? 'active' : '' }}">
                        <span class="nav-icon"><i class="fa-solid fa-users"></i></span>
                        <span class="nav-label">Benutzer</span>
                    </a>
                {% endif %}
                <a href="profil.php" class="nav-item {{ activePage == 'profil' ? 'active' : '' }}">
                    <span class="nav-icon"><i class="fa-solid fa-user"></i></span>
                    <span class="nav-label">Profil</span>
                </a>
            {% endif %}
        </nav>
    {% endblock %}
</div>
</body>
</html>
