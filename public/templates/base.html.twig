<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="{{ asset('site.webmanifest') }}">
    <title>{% block title %}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('css/fontawesome.css') }}">
    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    {% block head %}{% endblock %}
    <script src="{{ asset('js/form.js') }}" defer></script>
    <script src="{{ asset('js/db.js') }}" defer></script>
    {% if currentUser is defined and currentUser and currentUser.hash %}
    <script>
        localStorage.setItem('einkauf_hash', '{{ currentUser.hash }}');
    </script>
    {% endif %}
</head>
<body>
<div class="app">
    {% block header %}
        <header class="topbar">
            <div class="topbar-title">{% block pageTitle %}{% endblock %}</div>
            <div class="topbar-actions">
                {% block topbarActions %}{% endblock %}
            </div>
        </header>
    {% endblock %}

    <main class="content">
        {% block content %}{% endblock %}
    </main>

    {% block nav %}
        <nav class="bottom-nav" aria-label="Hauptnavigation">
            {% if currentUser is defined and currentUser %}
                <div id="sync-indicator" class="sync-indicator" title="Synchronisiere..." style="display: none;">
                    <i class="fa-solid fa-arrows-rotate fa-spin"></i>
                </div>
                {% if lists is defined and lists %}
                    {% for list in lists %}
                        <a href="start.php?id={{ list.id }}" class="nav-item {{ activePage == 'start' and activeListId == list.id ? 'active' : '' }}">
                            <span class="nav-icon"><i class="fa-solid fa-basket-shopping"></i></span>
                            <span class="nav-label">{{ list.name }}</span>
                        </a>
                    {% endfor %}
                {% else %}
                    <a href="start.php" class="nav-item {{ activePage == 'start' ? 'active' : '' }}">
                        <span class="nav-icon"><i class="fa-solid fa-basket-shopping"></i></span>
                        <span class="nav-label">Einkauf</span>
                    </a>
                {% endif %}
                {% if currentUser.is_admin %}
                    <a href="users.php" class="nav-item {{ activePage == 'users' ? 'active' : '' }}">
                        <span class="nav-icon"><i class="fa-solid fa-users"></i></span>
                        <span class="nav-label">Benutzer</span>
                    </a>
                {% endif %}
                <a href="profil.php" class="nav-item {{ activePage == 'profil' ? 'active' : '' }}">
                    <span class="nav-icon">
                        {% if currentUser.profile_image %}
                            <img src="uploads/logos/{{ currentUser.profile_image }}_30.webp" alt="Profil">
                        {% else %}
                            <i class="fa-solid fa-user"></i>
                        {% endif %}
                    </span>
                    <span class="nav-label">Profil</span>
                </a>
            {% endif %}
        </nav>
    {% endblock %}
</div>
</body>
</html>
