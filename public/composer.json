{
  "name": "snissel/einkauf",
  "type": "project",
  "require": {
    "php": ">=8.5",
    "ext-intl": "*",
    "twig/twig": "^3.8",
    "ext-zlib": "*",
    "ext-pdo": "*",
    "ext-gd": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "includes/"
    }

  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "../tests/"
    }
  },
  "config": {
